# Statik dosyaların başlıkları (Workers Static Assets). Worker'ın ürettiği yanıtların
# başlıkları workers/app.ts → app/domain/security/headers.ts içinde.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), browsing-topics=()

# Adı içerik karması taşıyan derleme çıktısı değişmez.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker her açılışta yenilik için denetlenir.
/sw.js
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'

/cevrimdisi
  Content-Security-Policy: default-src 'self'; style-src 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
